import pandas as pd
import joblib

# Load ML dataset
data = pd.read_csv("../data/ml_default_risk_dataset.csv")

# Load trained model
model = joblib.load("../models/default_risk_model.pkl")

print("Dataset loaded successfully!")
print("Model loaded successfully!")

# Features used by the model
features = [
    "total_bills",
    "total_units",
    "average_units",
    "average_bill",
    "total_bill_amount",
    "unpaid_count",
    "late_count",
    "unpaid_percentage"
]

# Prepare data for prediction
X = data[features]

# Predict default
data["prediction"] = model.predict(X)

# Get probability of default
data["risk_score"] = model.predict_proba(X)[:, 1] * 100

# Create risk level
data["risk_level"] = data["risk_score"].apply(
    lambda x: "HIGH" if x >= 70
    else "MEDIUM" if x >= 40
    else "LOW"
)

# Save predictions
data.to_csv(
    "../data/default_risk_predictions.csv",
    index=False
)

print("Risk predictions created successfully!")
print("Total customers:", len(data))
print()
print("Risk Level Distribution:")
print(data["risk_level"].value_counts())

print()
print("First 10 customers:")
print(
    data[
        [
            "consumer_id",
            "prediction",
            "risk_score",
            "risk_level"
        ]
    ].head(10)
)
